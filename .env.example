# Copie para .env e ajuste: cp .env.example .env
# O .env não deve ir para o git (já está no .gitignore).

# Domínio público. O Caddy emite o certificado HTTPS sozinho; o DNS precisa
# apontar para o servidor e as portas 80/443 precisam estar abertas.
DOMAIN=erp.exemplo.com.br

# Imagem do Odoo. Em produção prefira uma tag fixa já testada.
ODOO_IMAGE=craines/odoo-brasil:18.0

# Postgres (usado pelo container do banco e pelo Odoo)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=troque-esta-senha

# Senha master do Odoo (gerenciador de bancos). Gere uma forte:
#   openssl rand -base64 32
ODOO_PASSWORD=troque-esta-senha

# Gerenciador de bancos desligado em produção. Com LIST_DB=False,
# defina DATABASE ou DB_FILTER para o Odoo saber qual banco abrir.
LIST_DB=False
DATABASE=producao
DB_FILTER=^producao$

# Workers: regra prática (núcleos de CPU * 2) + 1. queue_job exige > 0.
WORKERS=5
QUEUE_JOB_CHANNELS=root:2

# Limite de memória por worker, em bytes (padrão 2 GiB / 2,5 GiB)
LIMIT_MEMORY_SOFT=2147483648
LIMIT_MEMORY_HARD=2684354560
TIME_CPU=6000
TIME_REAL=7200

# E-mail de saída
EMAIL_FROM=odoo@exemplo.com.br
SMTP_SERVER=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_SSL=False
SMTP_USER=False
SMTP_PASSWORD=False
