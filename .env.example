# Copie para .env e ajuste: cp .env.example .env
# O .env não deve ir para o git (já está no .gitignore).

# Domínio público. O Caddy emite o certificado HTTPS sozinho; o DNS precisa
# apontar para o servidor e as portas 80/443 precisam estar abertas.
DOMAIN=erp.exemplo.com.br

# Imagem do Odoo. Em produção use uma tag fixa já testada (18.0-AAAAMMDD).
# Tags disponíveis: https://github.com/edisonvitor/docker-odoo-brasil/pkgs/container/odoo-brasil
ODOO_IMAGE=ghcr.io/edisonvitor/odoo-brasil:18.0

# --- Postgres junto (docker-compose.prod.yml) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=troque-esta-senha

# --- Postgres externo (docker-compose.external-db.yml) ---
# Ignorado pelo docker-compose.prod.yml, que usa o Postgres do próprio compose.
#HOST=10.0.0.1
#PORT=5432
#USER=odoo
#PASSWORD=troque-esta-senha

# Senha master do Odoo (gerenciador de bancos). Gere uma forte:
#   openssl rand -base64 32
ODOO_PASSWORD=troque-esta-senha

# Gerenciador de bancos desligado em produção. Com LIST_DB=False,
# defina DATABASE ou DB_FILTER para o Odoo saber qual banco abrir.
LIST_DB=False
DATABASE=producao
DB_FILTER=^producao$

# Workers: regra prática (núcleos de CPU * 2) + 1. queue_job exige > 0.
WORKERS=5
QUEUE_JOB_CHANNELS=root:2

# Conexões ao Postgres por processo do Odoo (workers + cron + websocket).
# Com Postgres compartilhado, mantenha (WORKERS + 2) * DB_MAXCONN abaixo
# do max_connections disponível.
DB_MAXCONN=16

# Limite de memória por worker, em bytes (padrão 2 GiB / 2,5 GiB)
LIMIT_MEMORY_SOFT=2147483648
LIMIT_MEMORY_HARD=2684354560
TIME_CPU=6000
TIME_REAL=7200

# E-mail de saída
EMAIL_FROM=odoo@exemplo.com.br
SMTP_SERVER=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_SSL=False
SMTP_USER=False
SMTP_PASSWORD=False
